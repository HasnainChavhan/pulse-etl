KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=pulse.events
KAFKA_CONSUMER_GROUP=pulse-etl-consumer
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_BATCH_SIZE=500

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pulsetl
DB_POOL_SIZE=10

ANOMALY_STD_THRESHOLD=3.0
DEDUP_WINDOW_SECONDS=60
DEBUG=false
